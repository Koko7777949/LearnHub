generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String
  password    String
  role        String        // STUDENT | INSTRUCTOR | ADMIN
  avatarColor String        @default("indigo") // avatar gradient key
  headline    String?
  bio         String?
  country     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  courses               Course[]       @relation("InstructorCourses")
  enrollments           Enrollment[]
  instructorTransactions Transaction[] @relation("InstructorTransactions")
  studentTransactions   Transaction[] @relation("StudentTransactions")
  payouts               Payout[]
  reviews               Review[]
  wishlist              Wishlist[]
  couponsCreated        Coupon[]       @relation("CreatedCoupons")
}

model Course {
  id              String   @id @default(cuid())
  title           String
  subtitle        String
  description     String
  category        String   // Development | Business | Design | DataScience | Marketing | IT
  level           String   // BEGINNER | INTERMEDIATE | ADVANCED
  price           Float
  language        String   @default("English")
  coverGradient   String   @default("from-indigo-500 to-violet-600")
  status          String   @default("PUBLISHED") // DRAFT | PUBLISHED
  durationMinutes Int      @default(0)
  lessonsCount    Int      @default(0)
  rating          Float    @default(0)
  ratingCount     Int      @default(0)
  studentsCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instructorId String
  instructor   User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  lessons      Lesson[]
  enrollments  Enrollment[]
  transactions Transaction[]
  reviews      Review[]
  wishlistedBy Wishlist[]
  coupons      Coupon[]      @relation("CourseCoupons")
}

model Lesson {
  id              String           @id @default(cuid())
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id])
  title           String
  durationMinutes Int              @default(10)
  order           Int              @default(0)
  isPreview       Boolean          @default(false)
  videoUrl        String? // direct MP4/WebM URL, YouTube link, or /api/videos/<file> uploaded file
  progress        LessonProgress[]
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  student   User             @relation(fields: [studentId], references: [id])
  course    Course           @relation(fields: [courseId], references: [id])
  pricePaid Float
  progress  Float            @default(0)
  createdAt DateTime         @default(now())
  lessonProgress LessonProgress[]

  @@unique([studentId, courseId])
}

model Transaction {
  id                   String   @id @default(cuid())
  type                 String   // SALE | REFUND
  courseId             String
  course               Course   @relation(fields: [courseId], references: [id])
  studentId            String
  student              User     @relation("StudentTransactions", fields: [studentId], references: [id])
  instructorId         String
  instructor           User     @relation("InstructorTransactions", fields: [instructorId], references: [id])
  grossAmount          Float    // gross sale price (positive number)
  platformFee          Float    // 30% platform commission
  netEarnings          Float    // 70% instructor earnings
  status               String   @default("COMPLETED") // COMPLETED | REFUNDED
  description          String?
  refundReason         String?
  relatedTransactionId String?  // for REFUND entries -> original sale tx id
  createdAt            DateTime @default(now())
}

model Payout {
  id           String    @id @default(cuid())
  instructorId String
  instructor   User      @relation(fields: [instructorId], references: [id])
  amount       Float
  method       String    @default("PAYPAL") // PAYPAL | BANK_TRANSFER | STRIPE
  status       String    @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  note         String?
  requestedAt  DateTime  @default(now())
  processedAt  DateTime?
}

model Review {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  rating    Int      // 1..5 stars
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, studentId])
}

model LessonProgress {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, lessonId])
}

model Wishlist {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique // stored uppercase
  percentOff  Int // 5..100 (%)
  description String?
  courseId    String? // null = applies to the whole store
  course      Course?   @relation("CourseCoupons", fields: [courseId], references: [id])
  createdBy   String
  creator     User      @relation("CreatedCoupons", fields: [createdBy], references: [id])
  maxUses     Int       @default(100)
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  expiresAt   DateTime? // null = never expires
  createdAt   DateTime  @default(now())

  @@index([code])
}

# Database
# Adjust the path to wherever you cloned the repo (must be absolute for Prisma + SQLite)
DATABASE_URL="file:/absolute/path/to/your/project/db/custom.db"

# ---------------------------------------------------------------
# Stripe Checkout (real card payments)
# ---------------------------------------------------------------
# 1. Create an account at https://dashboard.stripe.com → Developers → API keys
# 2. Copy the SECRET key (sk_test_... for test mode, sk_live_... for live mode)
# 3. Set it below locally, or in Vercel: Project → Settings → Environment
#    Variables → add STRIPE_SECRET_KEY → redeploy.
#
# Test mode accepts the classic test card:
#   number: 4242 4242 4242 4242   expiry: any future date   CVC: any 3 digits
#
# While STRIPE_SECRET_KEY is empty the platform runs in demo mode:
# checkout enrolls instantly without any payment.
STRIPE_SECRET_KEY=""
# Optional overrides:
# STRIPE_MODE="live"          # badge switches from "test mode" to "live"
# STRIPE_CURRENCY="usd"       # checkout currency (usd/eur/...)
